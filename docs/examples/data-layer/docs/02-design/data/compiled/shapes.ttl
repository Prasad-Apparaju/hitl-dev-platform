@prefix : <https://hitl.dev/ns/system#> .
@prefix dt: <https://hitl.dev/ns/decision-trace#> .
@prefix hitl: <https://hitl.dev/ns/data-layer#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dt:DecisionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path dt:outcome ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path dt:decidedBy ],
        [ sh:class dt:Policy ;
            sh:minCount 1 ;
            sh:path dt:underPolicy ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path dt:decidedAt ] ;
    sh:targetClass dt:Decision ;
    hitl:confidence "confirmed" .

:carrierShape a sh:NodeShape ;
    sh:targetClass :carrier ;
    hitl:confidence "inferred" ;
    hitl:id "ent:carrier" .

:delivery-slotShape a sh:NodeShape ;
    sh:property [ sh:description "delivery_slots.slot_id from map:delivery-slot/warehouse.delivery_slots" ;
            sh:maxCount 1 ;
            sh:name "slot_id" ;
            sh:path :delivery-slot.slot_id ;
            hitl:confidence "needs-review" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0007" ],
        [ sh:description "delivery_slots.order_no from map:delivery-slot/warehouse.delivery_slots" ;
            sh:maxCount 1 ;
            sh:name "order_no" ;
            sh:path :delivery-slot.order_no ;
            hitl:confidence "needs-review" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0007" ],
        [ sh:description "delivery_slots.window_start from map:delivery-slot/warehouse.delivery_slots" ;
            sh:maxCount 1 ;
            sh:name "window_start" ;
            sh:path :delivery-slot.window_start ;
            hitl:confidence "needs-review" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0007" ] ;
    sh:targetClass :delivery-slot ;
    hitl:confidence "needs-review" ;
    hitl:id "ent:delivery-slot" .

:etaShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "eta_cache.computed_at from map:eta/shipments-db.eta_cache" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "computed_at" ;
            sh:path :eta.computed_at ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0011",
                "evidence/shipments-db/profile-20260930T0945.yaml#ev:shipments-db/profile/0002" ],
        [ sh:datatype xsd:string ;
            sh:description "eta_cache.order_no from map:eta/shipments-db.eta_cache" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "order_no" ;
            sh:path :eta.order_no ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0012",
                "evidence/shipments-db/profile-20260930T0945.yaml#ev:shipments-db/profile/0002" ],
        [ sh:datatype xsd:date ;
            sh:description "eta_cache.eta from map:eta/shipments-db.eta_cache" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "eta" ;
            sh:path :eta.eta ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0011",
                "evidence/shipments-db/profile-20260930T0945.yaml#ev:shipments-db/profile/0002" ] ;
    sh:targetClass :eta ;
    hitl:confidence "inferred" ;
    hitl:id "ent:eta" .

:order-lineShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "order_lines.order_id from map:order-line/orders-db.order_lines" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "order_id" ;
            sh:path :order-line.order_id ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/orders-db/profile-20260930T0940.yaml#ev:orders-db/profile/0002",
                "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0002" ],
        [ sh:datatype xsd:integer ;
            sh:description "order_lines.qty from map:order-line/orders-db.order_lines" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "qty" ;
            sh:path :order-line.qty ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0002" ],
        [ sh:datatype xsd:string ;
            sh:description "order_lines.part_id from map:order-line/orders-db.order_lines" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "part_id" ;
            sh:path :order-line.part_id ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0002" ],
        [ sh:datatype xsd:integer ;
            sh:description "order_lines.id from map:order-line/orders-db.order_lines" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "id" ;
            sh:path :order-line.id ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0002" ] ;
    sh:targetClass :order-line ;
    hitl:confidence "inferred" ;
    hitl:id "ent:order-line" .

:orderShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "orders.promised_date from map:order/orders-db.orders" ;
            sh:maxCount 1 ;
            sh:name "promised_date" ;
            sh:path :order.promised_date ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/orders-db/profile-20260930T0940.yaml#ev:orders-db/profile/0005",
                "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0001" ],
        [ sh:datatype xsd:integer ;
            sh:description "orders.id from map:order/orders-db.orders" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "id" ;
            sh:path :order.id ;
            hitl:confidence "confirmed" ;
            hitl:confirmedBy "human ta@team 2026-09-30T11:00:00Z" ;
            hitl:evidence "evidence/orders-db/profile-20260930T0940.yaml#ev:orders-db/profile/0005",
                "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0001" ],
        [ sh:class :shipment ;
            sh:name "fulfilled by" ;
            sh:path :order.fulfilled-by ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0005",
                "evidence/shipments-db/profile-20260930T0945.yaml#ev:shipments-db/profile/0007" ],
        [ sh:datatype xsd:string ;
            sh:description "orders.order_no from map:order/orders-db.orders" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "order_no" ;
            sh:path :order.order_no ;
            hitl:confidence "confirmed" ;
            hitl:confirmedBy "human ta@team 2026-09-30T11:00:00Z" ;
            hitl:evidence "evidence/orders-db/profile-20260930T0940.yaml#ev:orders-db/profile/0006",
                "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0001" ],
        [ sh:datatype xsd:string ;
            sh:description "orders.tenant_id from map:order/orders-db.orders" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "tenant_id" ;
            sh:path :order.tenant_id ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0001" ],
        [ sh:datatype xsd:string ;
            sh:description "orders.status from map:order/orders-db.orders" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "status" ;
            sh:path :order.status ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0001" ],
        [ sh:class :order-line ;
            sh:name "has" ;
            sh:path :order.has ;
            hitl:confidence "confirmed" ;
            hitl:confirmedBy "human ta@team 2026-09-30T11:00:00Z" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0001",
                "evidence/orders-db/schema-20260930T0930.yaml#ev:orders-db/schema/0002" ] ;
    sh:targetClass :order ;
    hitl:confidence "confirmed" ;
    hitl:id "ent:order" .

:shipmentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "shipments.eta from map:shipment/shipments-db.shipments" ;
            sh:maxCount 1 ;
            sh:name "eta" ;
            sh:path :shipment.eta ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/shipments-db/profile-20260930T0945.yaml#ev:shipments-db/profile/0005" ],
        [ sh:datatype xsd:string ;
            sh:description "shipments.carrier_ref from map:shipment/shipments-db.shipments" ;
            sh:maxCount 1 ;
            sh:name "carrier_ref" ;
            sh:path :shipment.carrier_ref ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0004",
                "evidence/shipments-db/profile-20260930T0945.yaml#ev:shipments-db/profile/0005" ],
        [ sh:class :carrier ;
            sh:maxCount 1 ;
            sh:name "carried by" ;
            sh:path :shipment.carried-by ;
            hitl:confidence "needs-review" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0004" ],
        [ sh:datatype xsd:string ;
            sh:description "shipments.order_no from map:shipment/shipments-db.shipments" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "order_no" ;
            sh:path :shipment.order_no ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0004",
                "evidence/shipments-db/profile-20260930T0945.yaml#ev:shipments-db/profile/0005" ],
        [ sh:datatype xsd:date ;
            sh:description "shipments.shipped_at from map:shipment/shipments-db.shipments" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "shipped_at" ;
            sh:path :shipment.shipped_at ;
            hitl:confidence "inferred" ;
            hitl:evidence "evidence/app/code-20260930T0900.yaml#ev:app/code/0009",
                "evidence/shipments-db/profile-20260930T0945.yaml#ev:shipments-db/profile/0005" ] ;
    sh:targetClass :shipment ;
    hitl:confidence "inferred" ;
    hitl:id "ent:shipment" .

